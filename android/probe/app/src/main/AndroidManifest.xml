<?xml version="1.0" encoding="utf-8"?>
<!-- Scam Sentinel call test: can an ordinary app hear the other person during a normal call on speaker?
     Nothing leaves the phone: recordings stay in the app's private storage. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Scam Sentinel call test"
        android:icon="@android:drawable/ic_lock_lock"
        android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".ProbeService" android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
