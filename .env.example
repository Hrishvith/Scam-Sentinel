# Copy to .env and fill in. .env is gitignored: never commit a real key.

# Required: a key from app.gnani.ai (needs Speech-to-Text and Text-to-Speech access).
GNANI_API_KEY=your-key-here

# Optional overrides (defaults shown).
# GNANI_BASE_URL=https://api.vachana.ai
# GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
# GNANI_CACHE_DIR=.cache

# Optional: Evon (30B open weights) behind any OpenAI-compatible server (vLLM / SGLang).
# When set, Evon gives a second opinion on the full call; the higher risk level wins.
# EVON_BASE_URL=http://localhost:8000/v1
# EVON_MODEL=gnani-evon-v3.3
# EVON_API_KEY=
